.DS_Store
.env
.env.*
!.env.example
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo
*.test
coverage.out

# Deploy bundle built by the console release step; 8 MB of derived output.
console-dist.tgz
admin-dist.tgz

# 网关的交叉编译产物，19 MB。和上面两个是同一类东西、同一个目录，只是一直
# 漏在忽略之外 —— 而 deploy.sh 要求先 scp 到 deploy/，所以每次发版这个二进制
# 都会出现在 `git status` 里等着被 `git add .` 顺手扫进去。
deploy/vodoge-gateway

# `go build ./...` 在 apps/gateway 里会按目录名吐一个同名二进制，同样 19 MB。
# 2026-09-11 差点被 `git add -A` 扫进去 —— 上面那条补完的第二天就又撞了一次，
# 所以这里按**模式**忽略，而不是再列一个路径。
apps/gateway/gateway

# Python 字节码。generate.py 被当脚本跑，于是 codegen/ 旁边会长出 __pycache__。
# 2026-09-05 有一个 .pyc 被 `git add packages/contract/` 扫进过仓库（9c099ad）。
__pycache__/
*.pyc

# 本机的临时工作目录。
#
# 🔴 不只是整洁问题：未被忽略的未跟踪文件会让 go build 打上
# vcs.modified=true，而 RUNBOOK 的「同一提交构建两次得到逐字节相同的
# 二进制」正是靠这个戳记成立的。2026-09-05 构建 gateway 时撞到：
# git status 看着干净（只有 scratchpad/），Go 却认为树是脏的。
scratchpad/
