# syntax=docker/dockerfile:1
#
# Building the gateway from source. Correct, and unusable on the production
# host -- which is exactly why the first thing this file does is refuse.
#
# The host has 2 vCPU and 1.6 GB of RAM. On 2026-08-24 a `docker compose build
# gateway` there sent it into memory thrashing: sshd and 443/444 stopped
# answering for 107 minutes (ICMP still replied, TCP still handshook, and every
# ssh attempt died with "Connection timed out during banner exchange" because
# sshd could not fork), and it took a hard reboot from the VPS console to get
# back. deploy/RUNBOOK.md had already said "do not do this". The document
# stopped nobody, so the refusal moved into the build itself.
#
# The mechanism is the ARG in the FROM line below. With BuildKit only the
# stages the target depends on are built, so when VODOGE_BUILD_FROM_SOURCE is
# anything but `yes`, `toolchain-yes` is not part of the graph and the Go
# toolchain image is never even pulled. Measured on the host: 0.9 s to refuse.
#
# On a machine that can actually compile -- CI, a workstation -- pass the arg:
#
#     docker build --build-arg VODOGE_BUILD_FROM_SOURCE=yes \
#       -f deploy/Dockerfile.gateway -t vodoge-cloud-gateway .
#
# Two alternatives were rejected. Pointing Compose at Dockerfile.gateway.prebuilt
# would make `docker compose build gateway` succeed cheaply -- and succeed just
# as cheaply against a stale deploy/vodoge-gateway, which is how you end up
# serving last week's code believing you deployed. Deleting the build stanza
# from compose.yaml makes `docker compose build gateway` print "No services to
# build" and exit 0, which is the same trap with better manners.

ARG VODOGE_BUILD_FROM_SOURCE=refuse

FROM alpine:3.22 AS toolchain-refuse
ARG VODOGE_BUILD_FROM_SOURCE
RUN set -e; \
    printf '%s\n' \
'' \
'  ===================================================================' \
'  REFUSING to build the gateway from source.' \
'' \
'  This host has 2 vCPU and 1.6 GB of RAM. Compiling Go here starved' \
'  sshd for 107 minutes on 2026-08-24 and needed a hard reboot from' \
'  the VPS console.' \
'' \
'  Deploy it this way instead:' \
'' \
'    on the workstation' \
'      cd apps/gateway' \
'      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \' \
'        -ldflags="-s -w" -o /tmp/vodoge-gateway ./cmd/gateway' \
'      scp /tmp/vodoge-gateway <host>:/opt/vodoge-cloud/deploy/' \
'' \
'    on the host' \
'      /opt/vodoge-cloud/bin/deploy.sh gateway' \
'' \
'    or, by hand, both lines -- the second one matters:' \
'      docker build -f Dockerfile.gateway.prebuilt -t vodoge-cloud-gateway .' \
'      docker compose ... up -d --no-build --force-recreate gateway' \
'' \
'  Without --force-recreate the tag has not changed, so Compose keeps' \
'  the old container and reports success. See deploy/RUNBOOK.md.' \
'' \
'  If this machine really can compile, say so:' \
'      docker build --build-arg VODOGE_BUILD_FROM_SOURCE=yes \' \
'        -f deploy/Dockerfile.gateway -t vodoge-cloud-gateway .' \
'  ===================================================================' \
'' >&2; \
    [ "$VODOGE_BUILD_FROM_SOURCE" = yes ]

FROM golang:1.23-alpine AS toolchain-yes

FROM toolchain-${VODOGE_BUILD_FROM_SOURCE} AS build

WORKDIR /src
COPY packages/contract/go packages/contract/go
COPY apps/gateway apps/gateway
WORKDIR /src/apps/gateway
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/vodoge-gateway ./cmd/gateway

FROM alpine:3.22

RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/vodoge-gateway /usr/local/bin/vodoge-gateway

ENV VODOGE_GATEWAY_ADDR=:8080
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/vodoge-gateway"]
