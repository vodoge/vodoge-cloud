POSTGRES_DB=vodoge
POSTGRES_USER=vodoge
POSTGRES_PASSWORD=change-me-postgres
VODOGE_OWNER_USER=vodoge_owner
VODOGE_OWNER_PASSWORD=change-me-owner
VODOGE_APP_USER=vodoge_gateway
VODOGE_APP_PASSWORD=change-me-gateway
REDIS_PASSWORD=change-me-redis
VODOGE_GATEWAY_PORT=18080
VODOGE_BASE_DOMAIN=vodoge.com

# 运维告警的收件租户与共享密钥。备份由 timer 触发,没有租户上下文,而 RLS 让
# 任何东西都无法枚举租户,所以收件人只能由这里指定。两个都留空则
# /v1/ops/backup-failed 返回 503,backup.sh 也会跳过上报。
VODOGE_OPS_TENANT=
VODOGE_OPS_TOKEN=
